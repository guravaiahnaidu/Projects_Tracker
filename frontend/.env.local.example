# Optional. Without it the app calls the backend on port 8000 of the same host name as the page.
# If you set it, use the SAME host name you open the app with (localhost vs 127.0.0.1): the sign-in cookie is
# SameSite=Strict and the two count as different sites.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
