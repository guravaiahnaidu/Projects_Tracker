# Copy to backend/.env for local development (never commit .env, never put real secrets in this example file).
#
# `python manage.py ...` defaults to DEVELOPMENT. Anything else that imports the settings (gunicorn, uvicorn,
# wsgi/asgi) defaults to PRODUCTION and REFUSES TO START unless the production values below are set.
DJANGO_ENV=development

# ---- development (all optional) -------------------------------------------------------------------
# DJANGO_DEBUG=true
# DJANGO_DB_PATH=            # default: backend/db.sqlite3
# DJANGO_TIME_ZONE=Asia/Kolkata   # authoritative zone for "today" (overdue / due today / key dates)

# ---- production (all required when DJANGO_ENV=production) ----------------------------------------
# DJANGO_SECRET_KEY=         # random, 50+ characters:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# DJANGO_ALLOWED_HOSTS=tracker.example.org
# DJANGO_API_REQUIRE_AUTH=true     # require a manager's JWT on every data endpoint (needs the frontend login first)
# DJANGO_ACKNOWLEDGE_NO_AUTH=true  # ONLY while DJANGO_API_REQUIRE_AUTH is off: access is restricted elsewhere (VPN/firewall/proxy auth)
# CORS_ALLOWED_ORIGINS=https://tracker.example.org      # https only
# Optional production hardening switches:
# DJANGO_BEHIND_PROXY=true   # trust X-Forwarded-Proto from a TLS-terminating proxy
# DJANGO_SSL_REDIRECT=true   # default true in production
# DJANGO_HSTS_SECONDS=3600   # raise (e.g. 31536000) once HTTPS is confirmed to work

# ---- JWT sign-in (optional; defaults shown) --------------------------------------------------------
# DJANGO_API_REQUIRE_AUTH=false      # development default: data API stays open, /api/auth/ works anyway
# DJANGO_JWT_SIGNING_KEY=            # default: DJANGO_SECRET_KEY. If set: random, 50+ characters. Changing it signs everyone out.
# DJANGO_JWT_ACCESS_MINUTES=15       # access token lifetime
# DJANGO_JWT_REFRESH_HOURS=24        # refresh token lifetime (rotated on every refresh)
# DJANGO_JWT_COOKIE_SAMESITE=Strict  # Strict or Lax
# DJANGO_JWT_COOKIE_DOMAIN=          # only if API and frontend are on sibling subdomains, e.g. .example.org
# DJANGO_JWT_COOKIE_SECURE=false     # always true in production; set true for local HTTPS
# DJANGO_THROTTLE_LOGIN=10/min       # sign-in attempts per client

# ---- throttling (optional; defaults shown) ---------------------------------------------------------
# DJANGO_THROTTLE_WRITE=120/min   # POST/PUT/PATCH/DELETE per client
# DJANGO_THROTTLE_READ=600/min    # GET/HEAD/OPTIONS per client (one dashboard load is ~15 requests)
# DJANGO_NUM_PROXIES=0            # trusted reverse proxies in front; 0 = ignore X-Forwarded-For. Use a shared cache (Redis) if running several workers.

# ---- PostgreSQL (optional; SQLite is the default) --------------------------------------------------
# DJANGO_DB_ENGINE=postgresql     # needs: pip install "psycopg[binary]"
# DJANGO_DB_NAME= / DJANGO_DB_USER= / DJANGO_DB_PASSWORD= / DJANGO_DB_HOST= / DJANGO_DB_PORT=   # environment only, never commit
